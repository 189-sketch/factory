# syntax=docker/dockerfile:1
# factory-core 共享 base:编译 core 二进制 + 非 root 运行时 + 双 UID(core/agent)。
# 两个 provider 镜像(Dockerfile.codex / Dockerfile.claude)都 FROM 本镜像,只叠加各自的 agent CLI。
# 遵循 R1:rootless/非 root 固定 UID/core 与 agent 不同 UID/禁 core dump;P2:凭据运行时 env 注入,不进镜像。

ARG RUST_TOOLCHAIN=1.96.0

# ---- build stage:编译 factory-core 二进制 ----
FROM rust:${RUST_TOOLCHAIN}-slim-bookworm AS build
WORKDIR /src

# 仅用缓存层拷清单,再拷源码
COPY Cargo.toml Cargo.lock ./
COPY factory-core/Cargo.toml ./factory-core/Cargo.toml
COPY factory-core/src ./factory-core/src

# rusqlite bundled 需要 C 工具链编译内嵌 sqlite
RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        build-essential pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN cargo build --release --locked -p factory-core \
    && cp target/release/factory /usr/local/bin/factory

# ---- runtime stage:最小运行时 + 双 UID ----
FROM debian:bookworm-slim AS base

LABEL org.opencontainers.image.title="factory-core base" \
      org.opencontainers.image.description="Factory in-container supervisor base (core binary + dual-UID runtime)"

# 运行时依赖:git(clone/工作区)、gh(agent 用 gh CLI 干活)、ca-certificates、jq(github source 适配器)、tini(PID1)
RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        git \
        gh \
        ca-certificates \
        jq \
        curl \
        tini \
    && rm -rf /var/lib/apt/lists/*

# 双 UID:core(账本/源码/凭据)与 agent(不可信代码)分离(R1 §一/§三)
ARG CORE_UID=1000
ARG AGENT_UID=1001
RUN groupadd --gid ${CORE_UID} factory \
    && useradd --uid ${CORE_UID} --gid factory --shell /usr/sbin/nologin --create-home factory-core \
    && groupadd --gid ${AGENT_UID} agent \
    && useradd --uid ${AGENT_UID} --gid agent --shell /bin/bash --create-home factory-agent

COPY --from=build /usr/local/bin/factory /usr/local/bin/factory

# 数据目录:账本与工作区,core 拥有
RUN mkdir -p /factory/data /factory/work \
    && chown -R factory-core:factory /factory \
    && chmod 700 /factory/data

# 禁 core dump(R1 §三)
ENV FACTORY_DATA_DIR=/factory/data \
    FACTORY_WORK_DIR=/factory/work \
    RUST_BACKTRACE=0

# 默认以 core 身份运行;agent 由 core spawn 时降权到 AGENT_UID
USER factory-core
WORKDIR /factory/work

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/factory"]
CMD ["agent-entrypoint"]
